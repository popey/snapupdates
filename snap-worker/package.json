{
	"name": "snap-worker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build:css": "sass --load-path=node_modules src/vanilla.scss public/vanilla.min.css --style=compressed --no-source-map",
		"deploy": "npm run build:css && wrangler deploy",
		"dev": "npm run build:css && wrangler dev",
		"start": "npm run build:css && wrangler dev",
		"test": "vitest run",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.7",
		"@types/node": "^25.5.0",
		"better-sqlite3": "^12.8.0",
		"sass": "^1.99.0",
		"sharp": "^0.35.0",
		"typescript": "^5.5.2",
		"vanilla-framework": "^4.48.0",
		"vitest": "^4.1.0",
		"wrangler": "^4.113.0"
	}
}
